{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS module manifest, a copy of the core validate_manifest rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "entry", "placement"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "entry": { "type": "string", "minLength": 1, "maxLength": 120, "description": "relative path inside the package, without \"..\"" },
    "placement": { "type": "string", "enum": ["panel", "widget", "button"] },
    "permissions": { "type": "array", "maxItems": 32, "items": { "type": "string", "description": "\"METHOD /path\" outside admin scopes" } },
    "network": { "type": "array", "maxItems": 32, "items": { "type": "string", "description": "domain without scheme and wildcards" } },
    "fs": { "type": "array", "maxItems": 32, "items": { "type": "string", "description": "explicit folder like ~/folder" } },
    "questions": { "type": "array" }
  }
}
