[Unit]
Description=Agent OS observer socket (agent-watch, A7-03)

[Socket]
ListenStream=/run/agent-watch.sock
Accept=yes
# The socket owner is set by the installer (agent-watch-install.sh) via the drop-in owner.conf: SocketUser=<owner>.
SocketMode=0600
MaxConnections=16
MaxConnectionsPerSource=16

[Install]
WantedBy=sockets.target
